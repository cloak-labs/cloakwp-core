{
  "name": "cloakwp/core",
  "description": "A set of OOP abstractions around WordPress core to improve developer experience.",
  "type": "library",
  "license": "LGPL-3.0-only",
  "require": {
    "php": ">=8.2",
    "composer/installers": "^2.2",
    "inpsyde/wp-context": "^1.5",
    "myclabs/deep-copy": "^1.11",
    "snicco/better-wp-api": "^1.9"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0 || ^12.0"
  },
  "autoload": {
    "psr-4": {
      "CloakWP\\Core\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CloakWP\\Core\\Tests\\": "tests"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "composer/installers": true,
      "franzl/studio": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}