{
  "name": "cloakwp/core",
  "description": "A set of OOP abstractions around WordPress core to improve developer experience.",
  "type": "library",
  "license": "LGPL-3.0-only",
  "require": {
    "php": ">=8.2",
    "myclabs/deep-copy": "^1.11"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0 || ^12.0"
  },
  "autoload": {
    "psr-4": {
      "CloakWP\\Core\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CloakWP\\Core\\Tests\\": "tests"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}